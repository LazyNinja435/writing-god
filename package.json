{
  "name": "ai-author-orchestration",
  "version": "1.0.0",
  "description": "Harness-agnostic, repository-driven AI operating system for long-form fiction authoring",
  "type": "module",
  "private": true,
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "fold": "tsx scripts/story-state/fold.ts",
    "fold:check": "tsx scripts/story-state/fold.ts --check",
    "test": "tsx --test scripts/story-state/fold.test.ts scripts/validate.test.ts scripts/lib/book-paths.test.ts scripts/lib/provenance-validation.test.ts"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.19.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18"
  }
}
