  "story_state_model": {
    "description": "Event-sourced narrative state: immutable events (with correction supersession) fold into derived views",
    "initial": "books/<book>/state/initial.json",
    "events": "books/<book>/state/events/evt-NNNNNN-*.json",
    "event_id_pattern": "evt-NNNNNN",
    "event_types": ["scene", "correction", "canon-change", "bootstrap"],
    "recorded_sequence": "mandatory unique positive integer per book (audit/append order)",
    "effective_sequence": "derived story replay position; corrections use chain-root recorded sequence",
    "supersession": "V1: only event_type correction may have supersedes; exactly one event_id; chains OK; branching rejected; replacement deltas required",
    "fold_pipeline": "load → schema validate → structural validate → resolveEffectiveHistory → sort by effectiveSequence → fold",
    "schema_validation": "scripts/lib/schema-validation.ts (shared by fold and validate)",
    "snapshots": "books/<book>/state/snapshots/",
    "derived": "books/<book>/state/derived/",
    "derived_files": [
      "current-characters.json",
      "current-knowledge.json",
      "current-timeline.json",
      "current-threads.json",
      "current-world.json",
      "current-inventory.json",
      "_manifest.json"
    ],
    "derived_manifest_fields": [
      "source_hash",
      "total_event_count",
      "active_event_count",
      "superseded_event_count",
      "active_event_ids",
      "superseded_event_ids",
      "latest_recorded_event_id",
      "latest_recorded_sequence",
      "last_effective_event_id"
    ],
    "active_event_ids_definition": "IDs of non-superseded events in effective replay order (effectiveSequence ascending)",
    "manuscript_provenance": {
      "required_on": ["scene", "correction_of_scene_root"],
      "fields": ["manuscript", "manuscript_hash", "scene_card", "approval_id?"],
      "approval_id_required_when": "book.yaml human_approval.scenes === true",
      "cross_checks": "scripts/lib/provenance-validation.ts",
      "safe_paths": "scripts/lib/book-paths.ts"
    },
    "knowledge_namespace": "changes.knowledge.<id>.* only",
    "fold_script": {
      "path": "scripts/story-state/fold.ts",
      "test": "scripts/story-state/fold.test.ts",
      "run": "npm run fold -- books/<book>",
      "check": "npm run fold:check -- books/<book>",
      "check_is_readonly": true
    },
    "rules": ".ai/rules/artifacts/state-events.md"
  },
  "approval_model": {
    "description": "Hash-bound human approval records gate canonical persistence (source_artifact → optional promotion_target)",
    "path": "books/<book>/approvals/",
    "schema": ".ai/schemas/approval.schema.json",
    "template": ".ai/templates/approval.template.json",
    "rules": ".ai/rules/artifacts/approvals.md",
    "skill": ".ai/skills/orchestration/verify-approval/SKILL.md",
    "lifecycle": "hash source → approve → verify source → promote → verify target → emit event",
    "stale_when": "source_artifact bytes no longer match artifact_hash",
    "promotion_waiting": "promotion_target may be absent until promote; once present must match artifact_hash"
  },
  "canon_model": {
    "description": "Explicit canon lifecycle for established story facts; separate from narrative state events",
    "statuses": ["PROPOSED", "CANON", "DEPRECATED", "RETCONNED", "UNKNOWN"],
    "authority": ".ai/rules/canon/canon-authority.md",
    "lifecycle": ".ai/rules/canon/canon-lifecycle.md",
    "location": "books/<book>/canon/",
    "proposals": "books/<book>/canon/proposals/",
    "scene_events_establish_canon": false
  },
  "manuscript_model": {
    "drafts": "books/<book>/manuscript/drafts/",
    "approved_scenes": "books/<book>/manuscript/scenes/",
    "promotion": "approval (when required) then drafts → scenes"
  },
