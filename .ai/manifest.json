  "default_workflow": {
    "description": "Standard fiction authoring agent startup and task flow",
    "steps": [
      "1. Read AGENTS.md",
      "2. Read .ai/manifest.json",
      "3. Read .ai/rules/rules.md",
      "4. Load mandatory project and canon rules",
      "5. Load task-applicable rules only",
      "6. Read .ai/protocols/protocols.md",
      "7. Select protocol (new-book vs existing-book) before book resolution",
      "8. Resolve active book only when needed (never example books for new-book)",
      "9. Read books/<book>/book.yaml",
      "10. Read .ai/genres/genres.md",
      "11. Load applicable genre packs only",
      "12. Match skills by When to Use",
      "13. Load specialist agents only when needed",
      "14. Load selective book context",
      "15. Execute protocol",
      "16. Run reviews",
      "17. Human approval + hash-bound approval record when configured",
      "18. Persist approved artifacts (promote drafts)",
      "19. Emit story-state events and canon proposals",
      "20. Verify completion"
    ]
  },
