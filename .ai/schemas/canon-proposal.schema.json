{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canon Proposal",
  "type": "object",
  "required": [
    "fact",
    "status"
  ],
  "properties": {
    "fact": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CANON",
        "DEPRECATED",
        "RETCONNED",
        "UNKNOWN"
      ]
    },
    "justification": {
      "type": "string"
    }
  }
}
