{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-author-orchestration.dev/schemas/story-event.schema.json",
  "title": "Story State Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "sequence",
    "changes"
  ],
  "$defs": {
    "sha256_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of file bytes as sha256:<64 lowercase hex>"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^apr-[0-9]{6,}$"
    },
    "manuscript_provenance": {
      "type": "object",
      "required": ["manuscript", "manuscript_hash", "scene_card"],
      "properties": {
        "manuscript": {
          "type": "string",
          "minLength": 1,
          "description": "Book-relative path to approved manuscript (e.g. manuscript/scenes/scene-0001.md)"
        },
        "manuscript_hash": {
          "$ref": "#/$defs/sha256_hash"
        },
        "approval_id": {
          "$ref": "#/$defs/approval_id",
          "description": "Required when book human_approval.scenes is true (enforced in TS)"
        },
        "scene_card": {
          "type": "string",
          "minLength": 1,
          "description": "Book-relative path to scene card YAML"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{6,}$",
      "description": "Independent event identity (not scene_id)"
    },
    "event_type": {
      "enum": [
        "scene",
        "correction",
        "canon-change",
        "bootstrap"
      ]
    },
    "scene_id": {
      "type": "string",
      "description": "Required for scene events; optional for others"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Recorded sequence: unique audit/append order per book (not necessarily story replay order)"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evt-[0-9]{6,}$"
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "description": "Only allowed on event_type correction. V1: exactly one event ID fully superseded"
    },
    "reason": {
      "type": "string"
    },
    "story_time": {
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/manuscript_provenance",
      "description": "Manuscript provenance; required for scene events and scene-root corrections"
    },
    "changes": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "location": { "type": "string" },
              "condition": { "type": "string" },
              "status": { "type": "string" },
              "injuries_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "injuries_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "relationships": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "state": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "knows_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "knows_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "believes_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "believes_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "suspects_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "suspects_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "does_not_know_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "does_not_know_removed": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "world": {
          "type": "object"
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "gained": {
                "type": "array",
                "items": { "type": "string" }
              },
              "lost": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "timeline": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "scene" } },
        "required": ["event_type"]
      },
      "then": {
        "required": ["scene_id", "provenance"]
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "correction" } },
        "required": ["event_type"]
      },
      "then": {
        "required": ["supersedes", "reason"],
        "properties": {
          "supersedes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true
          }
        }
      },
      "else": {
        "not": {
          "required": ["supersedes"]
        }
      }
    }
  ],
  "additionalProperties": false
}
