{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-author-orchestration.dev/schemas/story-event.schema.json",
  "title": "Story State Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "sequence",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{6,}$",
      "description": "Independent event identity (not scene_id)"
    },
    "event_type": {
      "enum": [
        "scene",
        "correction",
        "canon-change",
        "bootstrap"
      ]
    },
    "scene_id": {
      "type": "string",
      "description": "Required for scene events; optional for others"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Recorded sequence: unique audit/append order per book (not necessarily story replay order)"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evt-[0-9]{6,}$"
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "description": "V1: exactly one event ID fully superseded; chains (A←B←C) via successive corrections"
    },
    "reason": {
      "type": "string"
    },
    "story_time": {
      "type": "object"
    },
    "changes": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "location": { "type": "string" },
              "condition": { "type": "string" },
              "status": { "type": "string" },
              "injuries_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "injuries_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "relationships": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "state": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "knows_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "knows_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "believes_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "believes_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "suspects_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "suspects_removed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "does_not_know_added": {
                "type": "array",
                "items": { "type": "string" }
              },
              "does_not_know_removed": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "world": {
          "type": "object"
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "gained": {
                "type": "array",
                "items": { "type": "string" }
              },
              "lost": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "timeline": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "scene" } }
      },
      "then": {
        "required": ["scene_id"]
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "correction" } }
      },
      "then": {
        "required": ["supersedes", "reason"],
        "properties": {
          "supersedes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
